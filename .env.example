# ---- サーバ基本設定 ----
PORT=3000
HOST=0.0.0.0

# セッション署名用シークレット（本番では必ずランダムな長い文字列に変更）
SESSION_SECRET=change-me-to-a-long-random-string

# 先生アカウント登録の合言葉。
# 設定すると、登録画面に合言葉の入力欄が出て、一致しないと登録できなくなります。
# 未設定なら誰でも登録できます（ローカル・校内限定の運用ならこのままで構いません）。
# インターネットに公開する場合は、勝手に登録されてAI利用料が出るのを防ぐために設定してください。
# REGISTER_CODE=

# ---- データベース ----
# PostgreSQL接続文字列（Neon / Render / Railway など）
# 未設定の場合はローカルファイルDB（PGlite）で動作します（開発用）
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# ---- ファイル保存先 ----
# PDF・録音ファイルの保存ディレクトリ（デプロイ先では永続ボリュームを指定）
# DATA_DIR=./data

# ---- AIプロバイダー ----
# 文字起こし: mock | openai  （openai は OPENAI_API_KEY が必要）
TRANSCRIBE_PROVIDER=mock
# 要約: mock | anthropic | openai
# OpenAIのキー1つで済ませる場合は両方 openai + OPENAI_API_KEY を設定
SUMMARY_PROVIDER=mock

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.6-luna
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8
